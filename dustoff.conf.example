# dustoff 配置模板
#
# 用法：复制到 ~/.dustoff/dustoff.conf 后按需修改。
#   cp dustoff.conf.example ~/.dustoff/dustoff.conf
#
# 优先级：命令行参数 > 环境变量 > 本文件 > 脚本内置默认值。
# 注释以 # 开头。值不要加引号，含空格的路径直接写就行。

# ─────────────────────────────────────────────────────────────
# 路径
# ─────────────────────────────────────────────────────────────

# 运行时数据根目录。登录态、状态、运行记录都在这底下。
# 改了这个就等于换了一套身份，需要重新扫码登录。
DUST_HOME=~/.dustoff

# 视频落盘位置。这是唯一会长大的目录。
#
# 带 _INIT 后缀的键，只在 `node sync.mjs --init` 时生效。
# 所以两套值都写在这里，不需要来回改：
#   node sync.mjs          用 DUST_MEDIA        —— 落本机，约 61 MB/天
#   node sync.mjs --init   用 DUST_MEDIA_INIT   —— 落外接盘，全量约 29 GB
#
# 若外接盘没插，--init 会报错退出（退出码 5），
# 不会静默落回本机——那样会瞬间填爆系统盘。
DUST_MEDIA=~/.dustoff/media
DUST_MEDIA_INIT=/Volumes/YourDisk/dustoff-media

# 最终笔记的去处。这是你的资产，刻意放在 dustoff 之外——
# 工具可以被换掉，知识不该跟着走。
#
# ⚠️ 后半段（转文字 → 提炼笔记）尚未实现，目前没有脚本读这一项。
#    先在这里占位，等后半段做的时候直接用。
# 示例（iCloud 里的 Obsidian vault）：
# DUST_NOTES=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian/抖音收藏
DUST_NOTES=~/Documents/抖音收藏

# Chrome 可执行文件。默认是 macOS 标准位置。
# DUST_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ─────────────────────────────────────────────────────────────
# 扫描
# ─────────────────────────────────────────────────────────────

# 每次扫最新多少条。这是条数不是时间窗口。
# 按每天新增约 15 条的收藏速度换算：
#   100 条 ≈ 6.5 天　200 条 ≈ 13 天　500 条 ≈ 33 天
# 只要定时间隔短于覆盖天数就不会漏；漏跑几天也能自动补上。
DUST_SCAN_COUNT=200

# --init 时扫多少。给个足够大的数即可扫到底（实测约 5800 条的收藏夹需 10-12 分钟）。
DUST_SCAN_COUNT_INIT=99999

# 滚动轮数上限（安全阀，防止翻不到底时无限滚）。
DUST_MAX_ROUNDS=400

# 连续几轮没有新条目就收工。
# 不要调太小：滚了一轮没涨不代表到底了，可能只是响应还在路上。
DUST_STALL=4

# ─────────────────────────────────────────────────────────────
# 下载
# ─────────────────────────────────────────────────────────────

# 并发数。抖音 CDN 的并发上限没测过，从 3 起步比较稳。
DUST_CONCURRENCY=3

# 单次最多下载多少条（留空不限）。首次初始化时可用来分批。
# DUST_LIMIT=500

# 设为 1 则只打印计划、不真正下载。
# DUST_DRY_RUN=1

# 超过多少分钟的视频不下载。设 0 表示不限。
#
# 短视频的时长极度长尾：实测样本中位只有 58 秒，但最长的一条有
# 841 分钟。超长的多是合集、解说、全片，做知识笔记
# 价值低，却吃掉大量体积。实测各阈值的取舍：
#
#    阈值      拦下条数   占比    外推全量省
#    5 分钟      423    12.6%    18.0 GB   ← 砍太狠，会误伤深度内容
#   10 分钟      154     4.6%    12.6 GB   ← 性价比拐点
#   15 分钟       78     2.3%     9.8 GB
#   30 分钟       17     0.5%     6.2 GB
#
# 被拦下的不会丢弃，会计入汇总并列出最长的几条，想要的可以单独捞：
#   node scripts/fetch.mjs '<链接>'
#   DUST_MAX_DURATION_MIN=0 node sync.mjs      # 临时放开
DUST_MAX_DURATION_MIN=10

# ─────────────────────────────────────────────────────────────
# 运行记录与告警
# ─────────────────────────────────────────────────────────────

# 每次运行的记录（coll.json / result.json / run.log）保留多少天。
# 200 条约 280 KB，留 30 天约 8 MB。
# 留着的价值：下载失败时可在地址有效期内直接重试而不用重扫；
#             凌晨跑的任务出问题时，这是唯一的现场。
DUST_KEEP_RUNS=30

# 登录态剩余不足多少天开始预警。
# 实测 sessionid 有效期约两个月。
DUST_WARN_DAYS=7

# 媒体目录所在磁盘剩余空间低于多少 GB 时告警。
# 当前不会自动删除任何已下载的视频——因为还没有「这条处理过没有」的
# 状态记录，纯按时间删有可能删掉还没转成文字的。
DUST_MIN_FREE_GB=5

# 设为 0 关闭 macOS 系统通知（标记文件仍然会写）。
# DUST_NOTIFY=0

# ─────────────────────────────────────────────────────────────
# 转写（ASR）
# ─────────────────────────────────────────────────────────────

# 阿里云百炼 API key。这是唯一的凭据项，只存在于本文件里，
# 不进仓库、不进日志、不进运行记录。
# DUST_DASHSCOPE_KEY=sk-xxxxxxxx

# ASR 模型。选型依据见 docs/ASR选型-2026-09-02.md。
# 换成 fun-asr / paraformer-v2 不能直接改这里——它们走的是异步端点，
# 接口形态完全不同（提交 → 轮询 + 文件上传），脚本目前只实现了同步那套。
DUST_ASR_MODEL=qwen3-asr-flash

# 识别语种。zh / en / ja / ko 等，也可留空让模型自己判断。
DUST_ASR_LANG=zh

# 领域热词文件。喂给模型偏置识别，专名认对率提升明显：
# 不给热词认成 "cloud code"，给了就是 "Claude Code"。
# 一行一批、逗号分隔都行，想到新词随时加。
DUST_ASR_CONTEXT_FILE=~/.dustoff/asr-context.txt

# 也可以直接写在这里（会覆盖上面的文件）。适合词很少的情况。
# DUST_ASR_CONTEXT=Claude Code, MCP, RAG

# 并发。同步接口，单条 1-6 秒，2 条并发已经够快。
DUST_ASR_CONCURRENCY=2

# 连续失败多少条就中止整轮。
# 无人值守时的止损闸：余额耗尽或 key 失效会让每条都失败，
# 没有这道闸就会把剩下几千条挨个撞一遍。
DUST_ASR_MAX_FAILS=5

# 单条最多重试几次，超了标 failed 不再自动重试。
DUST_MAX_ATTEMPTS=3

# 转写稿落盘位置。刻意不放 media 目录下——mp4 会被清理，文字稿要活得更久。
DUST_TEXT=~/.dustoff/text
