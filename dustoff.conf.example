# dustoff 配置模板
#
# 用法：复制到 ~/.dustoff/dustoff.conf 后按需修改。
#   cp dustoff.conf.example ~/.dustoff/dustoff.conf
#
# 优先级：命令行参数 > 环境变量 > 本文件 > 脚本内置默认值。
# 注释以 # 开头。值不要加引号，含空格的路径直接写就行。

# ─────────────────────────────────────────────────────────────
# 路径
# ─────────────────────────────────────────────────────────────

# 运行时数据根目录。登录态、状态、运行记录都在这底下。
# 改了这个就等于换了一套身份，需要重新扫码登录。
DUST_HOME=~/.dustoff

# 视频落盘位置。这是唯一会长大的目录。
#
# 带 _INIT 后缀的键，只在 `node sync.mjs --init` 时生效。
# 所以两套值都写在这里，不需要来回改：
#   node sync.mjs          用 DUST_MEDIA        —— 落本机，约 61 MB/天
#   node sync.mjs --init   用 DUST_MEDIA_INIT   —— 落外接盘，全量约 29 GB
#
# 若外接盘没插，--init 会报错退出（退出码 5），
# 不会静默落回本机——那样会瞬间填爆系统盘。
DUST_MEDIA=~/.dustoff/media
DUST_MEDIA_INIT=/Volumes/YourDisk/dustoff-media

# 最终笔记的去处。这是你的资产，刻意放在 dustoff 之外——
# 工具可以被换掉，知识不该跟着走。
#
# notes.mjs 和 run.mjs 会把笔记写进这里。文件名用**收藏日期**——
# 回头找的时候记得住的是「我大概那阵子存的」。
# 示例（iCloud 里的 Obsidian vault）：
# DUST_NOTES=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian/抖音收藏
DUST_NOTES=~/Documents/抖音收藏

# Chrome 可执行文件。默认是 macOS 标准位置。
# DUST_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ─────────────────────────────────────────────────────────────
# 扫描
# ─────────────────────────────────────────────────────────────

# 每次扫最新多少条。这是条数不是时间窗口。
# 按每天新增约 15 条的收藏速度换算：
#   100 条 ≈ 6.5 天　200 条 ≈ 13 天　500 条 ≈ 33 天
# 只要定时间隔短于覆盖天数就不会漏；漏跑几天也能自动补上。
DUST_SCAN_COUNT=200

# --init 时扫多少。给个足够大的数即可扫到底（实测约 5800 条的收藏夹需 10-12 分钟）。
DUST_SCAN_COUNT_INIT=99999

# 滚动轮数上限（安全阀，防止翻不到底时无限滚）。
DUST_MAX_ROUNDS=400

# 连续几轮没有新条目就收工。
# 不要调太小：滚了一轮没涨不代表到底了，可能只是响应还在路上。
DUST_STALL=4

# ─────────────────────────────────────────────────────────────
# 下载
# ─────────────────────────────────────────────────────────────

# 并发数。抖音 CDN 的并发上限没测过，从 3 起步比较稳。
DUST_CONCURRENCY=3

# 单次最多下载多少条（留空不限）。首次初始化时可用来分批。
# DUST_LIMIT=500

# 设为 1 则只打印计划、不真正下载。
# DUST_DRY_RUN=1

# 超过多少分钟的视频不下载。设 0 表示不限。
#
# 短视频的时长极度长尾：实测样本中位只有 58 秒，但最长的一条有
# 841 分钟。超长的多是合集、解说、全片，做知识笔记
# 价值低，却吃掉大量体积。实测各阈值的取舍：
#
#    阈值      拦下条数   占比    外推全量省
#    5 分钟      423    12.6%    18.0 GB   ← 砍太狠，会误伤深度内容
#   10 分钟      154     4.6%    12.6 GB   ← 性价比拐点
#   15 分钟       78     2.3%     9.8 GB
#   30 分钟       17     0.5%     6.2 GB
#
# 被拦下的不会丢弃，会计入汇总并列出最长的几条，想要的可以单独捞：
#   node scripts/fetch.mjs '<链接>'
#   DUST_MAX_DURATION_MIN=0 node sync.mjs      # 临时放开
DUST_MAX_DURATION_MIN=10

# ─────────────────────────────────────────────────────────────
# 运行记录与告警
# ─────────────────────────────────────────────────────────────

# 每次运行的记录（coll.json / result.json / run.log）保留多少天。
# 200 条约 280 KB，留 30 天约 8 MB。
# 留着的价值：下载失败时可在地址有效期内直接重试而不用重扫；
#             凌晨跑的任务出问题时，这是唯一的现场。
DUST_KEEP_RUNS=30

# 登录态剩余不足多少天开始预警。
# 实测 sessionid 有效期约两个月。
DUST_WARN_DAYS=7

# 媒体目录所在磁盘剩余空间低于多少 GB 时告警。
# 只告警不删东西：该删的由保留期管（见 DUST_MEDIA_KEEP_DAYS），
# 那条路径认的是账本里的 transcribed_at，不是纯按时间。
DUST_MIN_FREE_GB=5

# 设为 0 关闭 macOS 系统通知（标记文件仍然会写）。
# DUST_NOTIFY=0

# ─────────────────────────────────────────────────────────────
# 转写（ASR）
# ─────────────────────────────────────────────────────────────

# 当前接入本机 AI 网关，使用 DashScope 原生 JSON 转写接口。
# 这里填写完整接口地址；不是 OpenAI multipart /audio/transcriptions。
DUST_ASR_BASE=http://127.0.0.1:8317/v1/asr/transcriptions
DUST_ASR_MODEL=qwen-asr
# 网关的 Dustoff 项目 Token，只存在于本机配置，不进仓库或日志。
# DUST_ASR_KEY=填写项目Token

# 兼容已有百炼直连：未设置 DUST_ASR_BASE 时沿用原官方端点；
# 模型可用 qwen-audio-3.0-asr-flash / qwen3-asr-flash。
# 旧 DUST_DASHSCOPE_KEY 仅在原官方端点生效，其他地址必须配置 DUST_ASR_KEY。
# fun-asr / paraformer-v2 的异步接口不在本客户端支持范围内。

# 识别语种。zh / en / ja / ko 等，也可留空让模型自己判断。
DUST_ASR_LANG=zh

# 领域热词文件。喂给模型偏置识别，专名认对率提升明显：
# 不给热词认成 "cloud code"，给了就是 "Claude Code"。
# 一行一批、逗号分隔都行，想到新词随时加。
DUST_ASR_CONTEXT_FILE=~/.dustoff/asr-context.txt

# 也可以直接写在这里（会覆盖上面的文件）。适合词很少的情况。
# DUST_ASR_CONTEXT=Claude Code, MCP, RAG

# 并发。同步接口，单条 1-6 秒，2 条并发已经够快。
DUST_ASR_CONCURRENCY=2

# 连续失败多少条就中止整轮。
# 无人值守时的止损闸：余额耗尽或 key 失效会让每条都失败，
# 没有这道闸就会把剩下几千条挨个撞一遍。
#
# 默认 3 而不是 5。串行跑（run.mjs）时「连续」是真的连续——三条都栽了
# 基本可以断定是系统性故障，没必要再撞两条。并发跑时这个数本来就只是个粗闸：
# 数到第 N 个失败，前面若干条其实已经发出去了。
DUST_ASR_MAX_FAILS=3

# 单条最多重试几次，超了标 failed 不再自动重试。
DUST_MAX_ATTEMPTS=3

# 转写稿落盘位置。刻意不放 media 目录下——mp4 会被清理，文字稿要活得更久。
# 每条产出 <id>.txt（纯文本）；模型给了时间戳的还会有 <id>.words.json。
DUST_TEXT=~/.dustoff/text

# 转写完成后保留 mp4 多少天再删。0 表示转完即可删。
#
# 不立即删的理由：转写质量还在验证期，热词表也在长。删早了发现问题
# 就得重新下载，而 CDN 地址会过期，等于要重新扫描一遍。
#
# 两条安全规则是写死在代码里的，配置改不了：
#   · 转写稿必须真的在磁盘上（账本说转过了不算数）
#   · 0 字的不删——那些是 ASR 什么也没听到的纯画面视频，
#     对它们来说视频本身仍是唯一的内容载体
DUST_MEDIA_KEEP_DAYS=7

# ── 归档：转写完的 mp4 搬到外接盘（默认行为，建议保持开启）─────
#
# 改成你自己的外接盘路径。留空则退回「本地放满 KEEP_DAYS 天然后删」，
# 那意味着素材最终会消失——只有在你确实不想留素材时才这么配。
#
# 为什么值得开：mp4 一年约 16.5 GB，而全部文字产物一年只有 35 MB——
# 相差 479 倍。内置盘装不下，外接盘装得下（实测余 538 GB，够放 30 年）。
# 搬过去之后就不再受保留期管辖，OCR 那天原料还在，
# 想重新转写也不用重下。
#
# **每轮全量扫，不只搬本轮刚转的。** 外接盘拔了几天，插回来的那一轮
# 会把这几天欠的一起补上——不会有视频因为「归档那天盘没插」而被删掉。
# 盘一直没插的话，保留期照常生效：那是内置盘的安全阀，不能取消。
#
# 盘没挂载时判断用的是**设备号**不是路径存在性。macOS 上外接盘没挂载时
# mkdir -p /Volumes/T7/xxx 会在启动盘上真的建出这个目录，然后把文件
# 全写进内置盘——那才是最坏的情况。
# 不填则用 $DUST_EXTERNAL/dustoff-media（想放别的盘上才需要单独填）
# DUST_MEDIA_ARCHIVE=

# ── 转写稿备份到外接盘（默认行为，强烈建议保持开启）───────────
#
# 跟上面的归档共用挂载点判断，但**是复制不是移动**——本地那份必须留着，
# 第三段每次提炼都要读它。
#
# 为什么这条比归档更重要：转写稿一年只有 35 MB，却是整条链路里唯一
# 花钱买来、丢了要重新掏钱的东西（全量重转约 ¥109）；而 mp4 一年
# 16.5 GB 却是可再生的（视频还在抖音上）。保护力度该跟体积反过来。
#
# 只增不删：本地删掉的，外接盘那份不跟着删——跟着删就不叫备份了。
# 不填则用 $DUST_EXTERNAL/dustoff-text
# DUST_TEXT_BACKUP=

# ─────────────────────────────────────────────────────────────
# 火山引擎 / 豆包语音（备选 ASR 提供方，已搁置）
# ─────────────────────────────────────────────────────────────
#
# 为什么值得试：豆包「录音文件识别极速版」同样是同步接口、同样支持
# base64 内联、同样返回词级时间戳，但音频时长上限是 2 小时而不是
# 千问的 300 秒——那意味着切片逻辑可以整个不用。单价也基本相同
# （¥0.8/小时 vs 千问 ¥0.792/小时），免费额度还更多。
#
# 唯一待验证的是热词。标准版（异步）文档里明确支持 corpus.context
# 直传 5000 词，但极速版文档没写。热词是专名认对率的关键
# （不给热词认成 cloud code，给了才是 Claude Code），所以这一项
# 决定了能不能换。
#
# ── 2026-09-03 搁置 ───────────────────────────────────────
# key 填了但一次都没测过，暂时放弃，后续再说。
# 搁置的理由是**热词，不是同步/异步**——极速版本身是同步的
# （volc.bigasr.auc_turbo，base64 内联，2 小时上限，比千问的 300 秒宽 24 倍）。
# 卡住的是：极速版支不支持 corpus.context 没有文档，而热词是命门；
# 加上 volc.bigasr.auc_turbo 这个名字暗示极速版跑的是上一代模型
# （标准版是 volc.seedasr.auc），有踩 paraformer 那个坑的风险。
# 回来重新评估时先测这两样，别按「必须异步」这个错前提判断。
#
# 怎么拿 key：火山引擎控制台 → 语音技术 → 应用管理，
# 新版控制台给的是一个 API Key，填到下面第一行即可。
# 如果你的控制台是旧版，给的是 App ID + Access Token 两个值，
# 那就填后面两行（新版 key 留空）。

# 新版控制台：一个 API Key
# DUST_VOLC_KEY=

# 旧版控制台：App ID + Access Token（仅在没有上面那个 key 时才需要）
# DUST_VOLC_APP_KEY=
# DUST_VOLC_ACCESS_KEY=

# 极速版的模型标识，固定值，一般不用改
DUST_VOLC_RESOURCE_ID=volc.bigasr.auc_turbo

# ─────────────────────────────────────────────────────────────
# 第三段：提炼笔记用的大模型（智谱 GLM）
# ─────────────────────────────────────────────────────────────
#
# 协议是 OpenAI 兼容的 Chat Completions，所以不需要装任何 SDK——
# 跟第二段调 DashScope 一样裸 fetch 就行，项目继续保持零依赖。
#
# 怎么拿 key：智谱开放平台 bigmodel.cn → 控制台 → API Keys。

DUST_LLM_KEY=
DUST_LLM_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 默认模型。glm-5.3-flash 官方叫「强制思考」模型，但这个说法要说清楚：
#   · 「不能关思考」指的是**不能传 thinking:{type:'disabled'} 这个参数**，
#     不是指模型一定会思考。实测 reasoning_effort='low' 时它是真的不思考——
#     reasoning_tokens 和 reasoning_content 两个信号一致，11 次全是 0。
#   · effort 只接受 low / high / max，传 medium 直接 400（错误码 1210）
#   · 支持 tool call，也支持看图——将来做 OCR 增强时，
#     同一个模型就能读关键帧，不必再引一个 OCR 引擎
DUST_LLM_MODEL=glm-5.3-flash
DUST_LLM_EFFORT=high

# ── 调它的三个坑（都是实测出来的，别踩）────────────────────
#
# ① effort 的参数名是 `reasoning_effort`（OpenAI 那套），不是 `thinking.effort`。
#    传 thinking:{type:'enabled', effort:'low'} **不报错，但 effort 被无视**——
#    实测同一个输入这样传烧了 659 个思考 token，而 reasoning_effort:'low' 是 0 个。
#    这是最坑的一个：它静默失败。
#
# ② 不传 effort 走的是 max，不是 high。真稿 1010 字，每档跑 4 次，
#    数字是 reasoning_tokens（思考 token 按输出计费）：
#       不传 effort              [ 2281  1121   634   126]   均 1041
#       reasoning_effort=max     [ 1320  1327  2529   529]   均 1426
#       reasoning_effort=high    [    7    94     5     5]   均   28
#       reasoning_effort=low     [    0     0     0     0]   均    0
#
#    两件事：
#    · 「不传」和 max 是同一个量级，跟 high 差约 40 倍。所以**必须显式传**——
#      漏掉是静默的，HTTP 200、结果照样对，只有账单悄悄变厚。
#    · 三档不是均匀的：low 和 high 几乎没差别（0 vs 28），
#      high 到 max 是 ~50 倍的断崖。high 不是中间档，它离 low 更近。
#      所以没必要为省钱去用 low——真正要躲的是漏传参数。
#
# ③ 思考 token 计入 completion_tokens，也就计入 max_tokens。
#    第一次测试给 max_tokens=800，模型拿 798 个去思考，正文一个字没剩下，
#    content 直接是空字符串——HTTP 200，不报错。max_tokens 要给够。
#
# response_format:{type:'json_object'} 可用，四次测试都能 JSON.parse。

# 并发和连续失败上限，语义同 DUST_ASR_*
DUST_LLM_CONCURRENCY=2
DUST_LLM_MAX_FAILS=3

# ─────────────────────────────────────────────────────────────
# 一趟跑完 · run.mjs
# ─────────────────────────────────────────────────────────────

# 日常增量的另一种编排：扫一次收藏夹，然后逐条串行走完 下载 → 转写 → 提炼。
# 跟三个独立入口共用同一本账本、同一批函数，不是第二套实现。
#
# 串行不是为了快（20 条约 4 分钟，分段并发约 2 分钟），是为了：
#   限流不用管（并发 1）· ffmpeg 的 spawnSync 不再阻塞别人 ·
#   止损闸变精确 · 日志是一条线性叙事
#
# ⚠️ 存量补录**不能**用它：CDN 签名地址 3~24 小时过期，
#    5831 条串行要 39 小时，跑一半地址就全废了。存量走 sync.mjs --init。

# 连续几条**整条链路**失败就中止本轮。
# DUST_RUN_MAX_FAILS=3

# ─────────────────────────────────────────────────────────────
# 外接盘：只配这一个
# ─────────────────────────────────────────────────────────────
#
# 三种用途全从这个根路径派生，换盘（T7 → T8）只改这一行：
#
#   $DUST_EXTERNAL/dustoff-media   mp4 归档，以及 --init 首次全量下载的落点
#   $DUST_EXTERNAL/dustoff-text    转写稿备份
#
# 分三处各写一遍完整路径的坏处：漏改一处就会一半文件去新盘、一半去老盘，
# 而老盘没插时那一半只会安静地跳过——未必发现得了。
#
# 留空则三样功能全关：mp4 走保留期删除、转写稿不备份、--init 下到本地。
DUST_EXTERNAL=/Volumes/T7

# 下载前用途判断（OpenAI 兼容 Chat Completions；只判断元数据）
# glm 使用 low 思考档位，支持 Base URL 或完整 /chat/completions 地址。
DUST_ROUTER_BASE=http://127.0.0.1:8317/v1
DUST_ROUTER_MODEL=glm
DUST_ROUTER_KEY=
# 视频收藏 / 图集 / 画面知识 / 同时保留视频笔记的素材：共用收藏目录和容量，不自动清理。
DUST_SAVED_MEDIA=~/.dustoff/saved-media
DUST_SAVED_MEDIA_MAX_GB=1
