# dustoff 配置模板
#
# 用法：复制到 ~/.dustoff/dustoff.conf 后按需修改。
#   cp dustoff.conf.example ~/.dustoff/dustoff.conf
#
# 优先级：命令行参数 > 环境变量 > 本文件 > 脚本内置默认值。
# 注释以 # 开头。值不要加引号，含空格的路径直接写就行。

# ─────────────────────────────────────────────────────────────
# 路径
# ─────────────────────────────────────────────────────────────

# 运行时数据根目录。登录态、状态、运行记录都在这底下。
# 改了这个就等于换了一套身份，需要重新扫码登录。
DUST_HOME=~/.dustoff

# 视频落盘位置。这是唯一会长大的目录。
#
# 带 _INIT 后缀的键，只在 `node sync.mjs --init` 时生效。
# 所以两套值都写在这里，不需要来回改：
#   node sync.mjs          用 DUST_MEDIA        —— 落本机，约 61 MB/天
#   node sync.mjs --init   用 DUST_MEDIA_INIT   —— 落外接盘，全量约 29 GB
#
# 若外接盘没插，--init 会报错退出（退出码 5），
# 不会静默落回本机——那样会瞬间填爆系统盘。
DUST_MEDIA=~/.dustoff/media
DUST_MEDIA_INIT=/Volumes/YourDisk/dustoff-media

# 最终笔记的去处。这是你的资产，刻意放在 dustoff 之外——
# 工具可以被换掉，知识不该跟着走。
#
# ⚠️ 后半段（转文字 → 提炼笔记）尚未实现，目前没有脚本读这一项。
#    先在这里占位，等后半段做的时候直接用。
# 示例（iCloud 里的 Obsidian vault）：
# DUST_NOTES=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian/抖音收藏
DUST_NOTES=~/Documents/抖音收藏

# Chrome 可执行文件。默认是 macOS 标准位置。
# DUST_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ─────────────────────────────────────────────────────────────
# 扫描
# ─────────────────────────────────────────────────────────────

# 每次扫最新多少条。这是条数不是时间窗口。
# 按每天新增约 15 条的收藏速度换算：
#   100 条 ≈ 6.5 天　200 条 ≈ 13 天　500 条 ≈ 33 天
# 只要定时间隔短于覆盖天数就不会漏；漏跑几天也能自动补上。
DUST_SCAN_COUNT=200

# --init 时扫多少。给个足够大的数即可扫到底（实测约 5800 条的收藏夹需 10-12 分钟）。
DUST_SCAN_COUNT_INIT=99999

# 滚动轮数上限（安全阀，防止翻不到底时无限滚）。
DUST_MAX_ROUNDS=400

# 连续几轮没有新条目就收工。
# 不要调太小：滚了一轮没涨不代表到底了，可能只是响应还在路上。
DUST_STALL=4

# ─────────────────────────────────────────────────────────────
# 下载
# ─────────────────────────────────────────────────────────────

# 并发数。抖音 CDN 的并发上限没测过，从 3 起步比较稳。
DUST_CONCURRENCY=3

# 单次最多下载多少条（留空不限）。首次初始化时可用来分批。
# DUST_LIMIT=500

# 设为 1 则只打印计划、不真正下载。
# DUST_DRY_RUN=1

# 超过多少分钟的视频不下载。设 0 表示不限。
#
# 短视频的时长极度长尾：实测样本中位只有 58 秒，但最长的一条有
# 841 分钟。超长的多是合集、解说、全片，做知识笔记
# 价值低，却吃掉大量体积。实测各阈值的取舍：
#
#    阈值      拦下条数   占比    外推全量省
#    5 分钟      423    12.6%    18.0 GB   ← 砍太狠，会误伤深度内容
#   10 分钟      154     4.6%    12.6 GB   ← 性价比拐点
#   15 分钟       78     2.3%     9.8 GB
#   30 分钟       17     0.5%     6.2 GB
#
# 被拦下的不会丢弃，会计入汇总并列出最长的几条，想要的可以单独捞：
#   node scripts/fetch.mjs '<链接>'
#   DUST_MAX_DURATION_MIN=0 node sync.mjs      # 临时放开
DUST_MAX_DURATION_MIN=10

# ─────────────────────────────────────────────────────────────
# 运行记录与告警
# ─────────────────────────────────────────────────────────────

# 每次运行的记录（coll.json / result.json / run.log）保留多少天。
# 200 条约 280 KB，留 30 天约 8 MB。
# 留着的价值：下载失败时可在地址有效期内直接重试而不用重扫；
#             凌晨跑的任务出问题时，这是唯一的现场。
DUST_KEEP_RUNS=30

# 登录态剩余不足多少天开始预警。
# 实测 sessionid 有效期约两个月。
DUST_WARN_DAYS=7

# 媒体目录所在磁盘剩余空间低于多少 GB 时告警。
# 当前不会自动删除任何已下载的视频——因为还没有「这条处理过没有」的
# 状态记录，纯按时间删有可能删掉还没转成文字的。
DUST_MIN_FREE_GB=5

# 设为 0 关闭 macOS 系统通知（标记文件仍然会写）。
# DUST_NOTIFY=0

# ─────────────────────────────────────────────────────────────
# 转写（ASR）
# ─────────────────────────────────────────────────────────────

# 阿里云百炼 API key。这是唯一的凭据项，只存在于本文件里，
# 不进仓库、不进日志、不进运行记录。
# DUST_DASHSCOPE_KEY=sk-xxxxxxxx

# ASR 模型。选型依据见 docs/ASR选型-2026-09-02.md。
#
# 脚本内置了两族同步模型的适配，改这一行即可切换：
#   qwen-audio-3.0-asr-flash   默认。2026-07 发布，附带逐词时间戳
#   qwen3-asr-flash            上一代，2025-09。无时间戳
# 两者同价（¥0.00022/秒，华北2），同为 300 秒上限。
#
# 换成 fun-asr / paraformer-v2 不能直接改这里——它们走的是异步端点，
# 接口形态完全不同（提交 → 轮询 + 文件上传），脚本没实现那套。
DUST_ASR_MODEL=qwen-audio-3.0-asr-flash

# 识别语种。zh / en / ja / ko 等，也可留空让模型自己判断。
DUST_ASR_LANG=zh

# 领域热词文件。喂给模型偏置识别，专名认对率提升明显：
# 不给热词认成 "cloud code"，给了就是 "Claude Code"。
# 一行一批、逗号分隔都行，想到新词随时加。
DUST_ASR_CONTEXT_FILE=~/.dustoff/asr-context.txt

# 也可以直接写在这里（会覆盖上面的文件）。适合词很少的情况。
# DUST_ASR_CONTEXT=Claude Code, MCP, RAG

# 并发。同步接口，单条 1-6 秒，2 条并发已经够快。
DUST_ASR_CONCURRENCY=2

# 连续失败多少条就中止整轮。
# 无人值守时的止损闸：余额耗尽或 key 失效会让每条都失败，
# 没有这道闸就会把剩下几千条挨个撞一遍。
DUST_ASR_MAX_FAILS=5

# 单条最多重试几次，超了标 failed 不再自动重试。
DUST_MAX_ATTEMPTS=3

# 转写稿落盘位置。刻意不放 media 目录下——mp4 会被清理，文字稿要活得更久。
# 每条产出 <id>.txt（纯文本）；模型给了时间戳的还会有 <id>.words.json。
DUST_TEXT=~/.dustoff/text

# 转写完成后保留 mp4 多少天再删。0 表示转完即可删。
#
# 不立即删的理由：转写质量还在验证期，热词表也在长。删早了发现问题
# 就得重新下载，而 CDN 地址会过期，等于要重新扫描一遍。
#
# 两条安全规则是写死在代码里的，配置改不了：
#   · 转写稿必须真的在磁盘上（账本说转过了不算数）
#   · 0 字的不删——那些是 ASR 什么也没听到的纯画面视频，
#     对它们来说视频本身仍是唯一的内容载体
DUST_MEDIA_KEEP_DAYS=7

# ─────────────────────────────────────────────────────────────
# 火山引擎 / 豆包语音（备选 ASR 提供方，评估中）
# ─────────────────────────────────────────────────────────────
#
# 为什么值得试：豆包「录音文件识别极速版」同样是同步接口、同样支持
# base64 内联、同样返回词级时间戳，但音频时长上限是 2 小时而不是
# 千问的 300 秒——那意味着切片逻辑可以整个不用。单价也基本相同
# （¥0.8/小时 vs 千问 ¥0.792/小时），免费额度还更多。
#
# 唯一待验证的是热词。标准版（异步）文档里明确支持 corpus.context
# 直传 5000 词，但极速版文档没写。热词是专名认对率的关键
# （不给热词认成 cloud code，给了才是 Claude Code），所以这一项
# 决定了能不能换。
#
# 怎么拿 key：火山引擎控制台 → 语音技术 → 应用管理，
# 新版控制台给的是一个 API Key，填到下面第一行即可。
# 如果你的控制台是旧版，给的是 App ID + Access Token 两个值，
# 那就填后面两行（新版 key 留空）。

# 新版控制台：一个 API Key
# DUST_VOLC_KEY=

# 旧版控制台：App ID + Access Token（仅在没有上面那个 key 时才需要）
# DUST_VOLC_APP_KEY=
# DUST_VOLC_ACCESS_KEY=

# 极速版的模型标识，固定值，一般不用改
DUST_VOLC_RESOURCE_ID=volc.bigasr.auc_turbo

# ─────────────────────────────────────────────────────────────
# 第三段：提炼笔记用的大模型（智谱 GLM）
# ─────────────────────────────────────────────────────────────
#
# 协议是 OpenAI 兼容的 Chat Completions，所以不需要装任何 SDK——
# 跟第二段调 DashScope 一样裸 fetch 就行，项目继续保持零依赖。
#
# 怎么拿 key：智谱开放平台 bigmodel.cn → 控制台 → API Keys。

DUST_LLM_KEY=
DUST_LLM_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 默认模型。glm-5.3-flash 官方叫「强制思考」模型，但这个说法要说清楚：
#   · 「不能关思考」指的是**不能传 thinking:{type:'disabled'} 这个参数**，
#     不是指模型一定会思考。实测 reasoning_effort='low' 时它是真的不思考——
#     reasoning_tokens 和 reasoning_content 两个信号一致，11 次全是 0。
#   · effort 只接受 low / high / max，传 medium 直接 400（错误码 1210）
#   · 支持 tool call，也支持看图——将来做 OCR 增强时，
#     同一个模型就能读关键帧，不必再引一个 OCR 引擎
DUST_LLM_MODEL=glm-5.3-flash
DUST_LLM_EFFORT=high

# ── 调它的三个坑（都是实测出来的，别踩）────────────────────
#
# ① effort 的参数名是 `reasoning_effort`（OpenAI 那套），不是 `thinking.effort`。
#    传 thinking:{type:'enabled', effort:'low'} **不报错，但 effort 被无视**——
#    实测同一个输入这样传烧了 659 个思考 token，而 reasoning_effort:'low' 是 0 个。
#    这是最坑的一个：它静默失败。
#
# ② 不传 effort 比传 high 贵一个数量级。真稿 1010 字，每档跑 4 次，
#    数字是 reasoning_tokens：
#       不传 effort              [ 301 1578  403  703]   均 746
#       reasoning_effort=high    [   0    5  144  104]   均  63
#       reasoning_effort=low     [   0    0    0    0]   均   0
#    注意 high 和不传的**波动都极大**（不传最高 1578，最低 301），
#    只跑一次得出的结论不可信；low 是唯一稳定的一档。
#    思考 token 按输出计费，所以这一项直接决定第三段的账单。
#
# ③ 思考 token 计入 completion_tokens，也就计入 max_tokens。
#    第一次测试给 max_tokens=800，模型拿 798 个去思考，正文一个字没剩下，
#    content 直接是空字符串——HTTP 200，不报错。max_tokens 要给够。
#
# response_format:{type:'json_object'} 可用，四次测试都能 JSON.parse。

# 并发和连续失败上限，语义同 DUST_ASR_*
DUST_LLM_CONCURRENCY=2
DUST_LLM_MAX_FAILS=5
