# 运行时数据（默认在 ~/.dustoff/，但防止有人把 DUST_HOME 指到仓库里）
.cache/
.runs/
.state/
.chrome-profile/
NEEDS_LOGIN

# 登录凭据与本机配置
cookies.json
token.json
dustoff.conf
.env

# 扫描/下载的中间产物与结果
coll*.json
result*.json
*.log

# 媒体文件绝不入库
*.mp4
*.wav
*.mp3
*.png
*.jpg

# 系统与编辑器
.DS_Store
node_modules/
.vscode/
.idea/
__pycache__/
*.pyc

# 私有项目文档与本机编辑器配置
/docs/
*.code-workspace
